# Copy to .env and fill in. Never commit .env.

# The site's public address, without a trailing slash. Used for link previews, and the
# admin only accepts requests coming from this address.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# A long random string that signs login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Database. Locally, `docker compose up -d postgres` starts one with these settings.
# (In Docker, docker-compose.yml builds DATABASE_URL from the POSTGRES_* values itself.)
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=
POSTGRES_DB=portfolio
DATABASE_URL=postgres://portfolio:PASSWORD_FROM_ABOVE@127.0.0.1:5432/portfolio

# The first editor account, created when the database has no users yet. Without these,
# the first visit to /admin asks you to create one: do that straight after deploying.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Set to false to stop the server from loading the default content into an empty database.
# SEED_ON_INIT=true

# Only with `docker compose --profile https`: the domain Caddy gets a certificate for.
# DOMAIN=example.com
